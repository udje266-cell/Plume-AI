{
  "name": "plume-ai",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "node scripts/bundle.mjs && node dev-server.mjs",
    "build": "node scripts/bundle.mjs && bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "format": "prettier --write src scripts",
    "test": "node --test",
    "deploy": "npx wrangler@4 deploy"
  }
}
